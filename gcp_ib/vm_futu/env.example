# ~/zhuge/env（chmod 600；只喺 VM 上面填，唔好貼入對話、唔好 commit）
ZHUGE_GCP_URL=https://zhuge-risk-manager-1056099871997.europe-west1.run.app/
WEBHOOK_SECRET_TOKEN=（同 Cloud Run 一樣嘅權杖）
TG_BOT_TOKEN=（Telegram bot token，選填）
TG_CHAT_ID=（Telegram chat id，選填）
ZHUGE_COMBINED_EQUITY=（合計權益 HKD，同部機 setx 嘅一樣）
ZHUGE_ALERT_CUSHION=15000
PYTHONIOENCODING=utf-8
# 部機有 setx 過嘅其他推送設定都抄過嚟（冇就唔使），例如：
# FUTU_SYMBOLS=US.QQQ,HK.800000,HK.HSI_FRONT
# FUTU_DAILY_MAX=60
