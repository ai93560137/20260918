# [R191] futu-data VM 嘅「唔係秘密」設定（公開 repo）：改呢度 → PR → 合併 →「更新部機」，
# VM 10 分鐘內自動套用（update.sh 會重開推送服務，OpenD 唔重開）。
# 權杖、密碼、權益、按金緩衝金額一律唔好放呢度（repo 公開），留喺 VM 嘅 ~/zhuge/env。
# 呢個檔喺 ~/zhuge/env 之後載入，同名以呢度為準。
# 格式：一行一個 KEY=VALUE；行頭有 # 即係用程式預設值（下面寫住嘅就係預設）。
# ⚠ systemd 唔支援行尾註解：說明一定要寫喺上一行，唔好寫喺值後面。

# ── futu/push_to_gcp.py 富途行情推送 ──
# 要推 K 線＋期權鏈嘅代號，逗號分隔（程式預設只有 US.QQQ）
# [R192] 跟返部機搬過嚟之前推緊嘅清單：HK.HSI_FRONT（即月期貨 1 分 K／5 分 K，地載陣、蛇蟠陣靠佢）、HK.800000（恒指）、HK.800125
FUTU_SYMBOLS=US.QQQ,HK.800000,HK.800125,HK.HSI_FRONT
# 幾耐推一次（秒，最少 60）
#PUSH_INTERVAL_SEC=300
# 每次幾多根 K 線（10–1000）
#BAR_COUNT=120
# 價平上下幾檔期權
#ATM_STRIKES=2
# 0 = 唔推日線
#FUTU_DAILY=1
# 日線根數（5–100）
#FUTU_DAILY_BARS=20
# 日線最多幾隻（1–1000）
#FUTU_DAILY_MAX=60
# 日線每批訂閱幾隻（訂閱額度 100）
#FUTU_DAILY_BATCH=50
# 額外要推日線嘅代號，逗號分隔
#FUTU_DAILY_EXTRA=
# 0 = 即月期貨唔推 1 分 K
#FUTU_FRONT_1M=1
# 0 = 1 分 K 唔使每分鐘推
#FUTU_FRONT_1M_FAST=1

# ── futu/iv_push.py 期權 IV 採集 ──
# 採集邊幾個市場
#IV_MARKETS=HSI,ES,NQ
# 每邊幾檔（2–30）
# [R195] 風揚陣（使用者 10-15 要求）：10 檔只覆蓋現價 ±約 250 點，1σ 行使價（±500 點）冇真實買賣價 → 加到上限 30
IV_STRIKES=30
# 幾耐採一次（秒，最少 300）
#IV_INTERVAL_SEC=1800

# ── gcp_ib/auto_risk.py 風險（只放比例，唔放金額）──
# 硬止損警報比例
#ZHUGE_ALERT_STOP=0.8

# ── 🐉 龍飛陣 hsi_ai_trader（R199）──
# [R209] 已唔再用：模擬程式永遠 SIMULATE（前向測試唔停）；真倉由下面 LONGFEI_REAL_PRODUCTS 開另一組程式
TRD_ENV=SIMULATE
# 風控級別檔：auto_risk 每 10 分鐘寫，longfei_guard 讀（Ⓑ→PAUSE；Ⓒ／Ⓓ／硬止損／檔案舊過 30 分鐘→只發 Telegram，使用者 10-16 定）
ZHUGE_LADDER_FILE=~/zhuge/ladder_level
# [R205] 證券戶口（龍飛陣美股 ETF）風控級別檔：auto_risk 寫（線 Ⓑ 3 萬／Ⓒ 2 萬／Ⓓ 1 萬，唔分日夜）
ZHUGE_SEC_LADDER_FILE=~/zhuge/ladder_level_sec
# =1 先令 SPY／QQQ／DIA 跟證券戶口級別（未開就照舊跟期貨戶口）。轉真倉前、證券戶口入咗錢先開（RISK_LADDER §6b）
LONGFEI_ETF_SEC_LADDER=1
# [R208][R209] 真倉：逐隻列明（HSI、SPY、QQQ、DIA），每隻另開 zhuge-longfei-real@<產品>（資料 ~/zhuge/ai_trader_real_<產品>），
# 模擬程式照跑前向測試。要使用者親口講轉邊隻先改；有 ETF 就同一個 PR 開 LONGFEI_ETF_SEC_LADDER=1。合併＋「更新部機」後 10 分鐘內自動開／停
# （update.sh → longfei_units.sh；拎走仍有倉嘅產品會先放 STOP 平倉）。成績存 GCS longfei/real/<產品>/，網頁真倉同模擬倉分開。
# 每隻真倉另外 call Claude（費用多一份）。程式每 30 分鐘唯讀檢查真實戶口（入金、孖展、可買／可沽空、PDT），結果喺 status.real_preflight
# [R242] 使用者 10-19 深夜：「SPY、QQQ 不做真倉，現在所有美股先跑模擬，待結果滿意才做真倉」→ 冇真倉產品
# [R222][R287] 使用者 10-23：真倉改用小型恒指 MHI（風險係 HSI 五分之一；HSI 模擬照跑累積樣本）。使用者講「MHI 轉真倉」先合併；美股照舊冇真倉
LONGFEI_REAL_PRODUCTS=MHI
# [R287→R300] MHI 真倉每日蝕上限：10-23 定 HK$10,000；10-27 使用者揀「固定 10 張＋提高日蝕上限」改 HK$30,000
DAILY_LOSS_LIMIT_MHI=30000
# [R300] 使用者 10-27「一次只可以揸一張，改為一次可以最多 10 張」，揀「固定 10 張＋提高日蝕上限」：
#   MHI 真倉每次開 10 張；波段止蝕最少 120 點＝每單約 HK$12,000，所以日蝕上限 HK$10,000 → 30,000（上面）
MAX_QTY_MHI=10
# [R305] 使用者 10-27「每單一張逐張加落去最多加到 10 張，因為你嘅表現暫時未穩定」，揀「按成績升級」：
#   由 1 張開始；平倉賺錢下一單 +1 張、蝕錢 −1 張（最少 1、最多 MAX_QTY_MHI=10）；級數記喺程式 state，heartbeat 睇 size_level
SIZE_LADDER=1
# [R302] 使用者 10-27「MHI2610 喺 10-29 轉月。最後一星期波段用下一月」：最後交易日前 7 日（日曆日）起真倉改用下一個月合約
ROLL_DAYS_MHI=7
# [R294] 使用者 10-26「信心 0.65」：真倉開倉要 AI 信心 ≥ 0.65（模擬唔受影響）
REAL_MIN_CONFIDENCE=0.65
# [R297] 使用者 10-27「批 #133」：浮賺 ≥ 1R 之後程式自動將止蝕移到開倉價（保本），IDEAS #133
BREAKEVEN_AT_R=1
# [R299] 使用者 10-27「開倉前先查購買力。ok」：MHI 真倉冇倉時先問富途最多可開張數，兩邊都 0 就 HOLD 唔叫 AI
REAL_BP_CHECK=1
# [R299] 使用者 10-27「揸耐啲、止蝕闊啲。ok」（IDEAS #135）：MHI 真倉波段——AI 揀入場、程式管出場（只限真倉）
#   止蝕最少 120 點、每日最多開 5 次（R303；原本 1 次）、浮賺 165 點後用 165 點移動止蝕、最多揸 3 個交易日；可過夜；R297 保本照舊
SWING_EXIT=1
SWING_MIN_STOP=120
# [R303] 使用者 10-27「改做每日最多五次」：每日上限 1 → 5（日蝕上限 HK$30,000 照舊，約兩單全額止蝕之後程式會因剩餘額度唔夠而拒絕再開）
SWING_MAX_OPENS=5
SWING_TRAIL_START=165
SWING_TRAIL=165
SWING_MAX_DAYS=3
# [R347] 使用者 10-27「叫龍飛陣照做」（總指揮轉達）：MHI 真倉冇倉時，價仲喺上次 AI HOLD 嘅觸發位之間、距上次叫 AI < 30 分鐘就沿用 HOLD，
#   唔叫 Haiku／Opus。先 shadow（照叫 AI，heartbeat 記 reuse_shadow_today／reuse_shadow_open_today）一兩日，冇擋走開倉先改 on
REUSE_HOLD=shadow
REUSE_HOLD_MAX_MIN=30
# [R348] 使用者 10-28「數據之前4小時不入市」（所有真倉，RISK_LADDER §6d）：美國高影響數據（FOMC、CPI、非農等）前 4 小時
#   MHI 真倉唔開新倉、冇倉唔叫 AI；有倉照管。日曆＝ops/us_data_manual.json＋ForexFactory（部機每 6 小時抓）。0＝關
DATA_BLOCK_HOURS=4
# [R353] 使用者 10-29「批 #147 開市時段唔開新倉」：港期日市開市頭 5 分鐘、A 股開市（09:30）前後，MHI 真倉唔開新倉、冇倉唔叫 AI；有倉照管
#   IDEAS #147：09:31–09:35 每分鐘幅度係平時 2.9 倍、09:16–09:20 係 2.2 倍。夜市開市未研究，唔包。空＝關
OPEN_BLOCK_WINDOWS=09:15-09:20,09:28-09:36
# [R295] 使用者 10-26「模擬唔再用 api call，改為即日回測」：模擬倉唔叫 Claude，只存 K 線；回測由 Actions longfei_rulesim.yml 做。真倉（MHI）唔受影響
LONGFEI_SIM_AI=0
# [R233][R235] 美股真倉倉位（使用者 10-19：用盡富途槓桿、唔留緩衝）。只影響真倉程式，模擬照用產品預設。
# REAL_SIZE_MAX=1：股數 = 富途而家最多可買／可沽空 ÷ 未有倉嘅真倉美股隻數
# [R249] 使用者 10-20 揀：將來真倉每單 0.1 × 實時權益（R248 購買力重演：差唔多全部模擬單都做得到），取代用盡槓桿
REAL_SIZE_MAX=0
REAL_SIZE_FRAC=0.1
# [R251] 每隻日蝕 HK$10,000（使用者 10-20 由 5 萬改）；真倉美股合計日蝕 HK$100,000（使用者 10-19 揀）
REAL_DAILY_LOSS_STOCK=10000
REAL_ETF_TOTAL_DAILY_LOSS=100000
# 唔用盡槓桿時嘅每單金額（REAL_SIZE_MAX=0 先生效）
#REAL_NOTIONAL_USD=10000
# [R234] 真倉後備止蝕：開倉即喺富途伺服器掛 GTC 止損單，觸發價比程式止蝕再遠 0.3%（美股預設開；港期未驗證預設關）
# [R267] 10-21 真期貨戶口實測 HSI STOP／STOP_LIMIT（GTC）掛、改、撤全部成功（WAITING_SUBMIT＝富途伺服器持有）→ 港期都開
SERVER_STOP=1
#SERVER_STOP_BUFFER_PCT=0.3
# [R218] 決策模型：預設 Opus 5.5（使用者 10-17 揀最強而價錢合理）；想轉返 Sonnet 寫 CLAUDE_MODEL=claude-sonnet-5-5
#CLAUDE_MODEL=claude-opus-5-5
# AI 思考深度（low／medium／high…；預設 medium）。思考 token 計 output 費，降低可慳錢但影響質素
#CLAUDE_EFFORT=medium
# [R218] 方案 A：冇倉時先用 Haiku 5.5 篩，值得睇先問決策模型（有倉唔篩）。留空 GATE_MODEL= 就唔篩
#GATE_MODEL=claude-haiku-5-5
# [R202] 龍飛陣其他產品（每隻一個 zhuge-longfei@<產品>.service、資料 ~/zhuge/ai_trader_<產品>，各自 call Claude，費用 ×N）
# HSI 由 zhuge-longfei.service 跑，唔使寫喺度。留空＝只跑 HSI。改呢行要「更新部機」後喺 VM 跑一次 setup.sh 先會開新產品
# [R225] 使用者 10-18：加科技七雄 AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA（共 24 個模擬程式；部機要先升 8GB）
LONGFEI_EXTRA_PRODUCTS=SPY,QQQ,DIA,TLT,HYG,GLD,USO,IWM,EWJ,FXI,EWT,INDA,EZU,EWU,EWZ,EWC,AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA
