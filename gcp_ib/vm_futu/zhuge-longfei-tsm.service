[Unit]
Description=Zhuge 龍飛陣 12 個月動量 MNQ／MES（hsi_ai_trader/tsm_monthly.py；只有 settings.env LONGFEI_TSM_PRODUCTS 列明先落真單）
After=zhuge-opend.service network-online.target
Wants=zhuge-opend.service
[Service]
OOMScoreAdjust=500
MemoryMax=300M
Type=oneshot
User=@USER@
WorkingDirectory=@HOME@/20260918/hsi_ai_trader
EnvironmentFile=@HOME@/zhuge/env
EnvironmentFile=-@HOME@/20260918/gcp_ib/vm_futu/settings.env
ExecStart=/usr/bin/env TSM_DIR=@HOME@/zhuge/tsm @HOME@/zhuge-venv/bin/python tsm_monthly.py
TimeoutStartSec=900
