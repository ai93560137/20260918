//@version=6
// =============================================================================
// 智能諸葛亮 · 空城計 v1 — 一個只會叫你「不要動」的指標
//
// 諸葛亮面對十五萬大軍，城中無兵。他開城門、焚香撫琴，什麼都不做——因此贏了。
//
// 這支指標刻意沒有「買進」訊號，也沒有「賣出」訊號。
// **它唯一的輸出是：現在可不可以動。**
//
// 為什麼這樣設計：
//   本專案測過七個「該做什麼」的假設，六個死掉。
//   但有一件事在每一次測試裡都成立：**在最壞的時刻做出的決定，幾乎都是錯的。**
//   爆掉的人不是平時爆的，是在「這次我很有把握」那一次爆的。
//
// 所以這支工具的價值不在於它告訴你什麼，
// 在於它在你最想破例的那一天，擋在你和鍵盤之間。
//
// ⚠️ 它不能被用來合理化任何行動。它沒有那個狀態。
//
// 用法：掛在你交易的期貨圖表上（ES / NQ / HSI 日線或小時線）。
//       每天開盤前看一眼。紅色就關掉電腦。
// =============================================================================
indicator("智能諸葛亮 · 空城計 v1｜最壞情況下什麼都不做", "空城計", overlay = true)

const string G_P = "① 你的處境（手動更新）"
const string G_M = "② 市場條件"
const string G_D = "③ 顯示"

// ── 你的處境：這幾個數字每週更新一次就夠 ──
expNow   = input.float(0.53, "目前名義曝險（倍）", minval = 0.0, step = 0.1, group = G_P,
     tooltip = "進場時的名義曝險 ÷ 權益。不是平均值，是現在這一刻。")
expMax   = input.float(1.70, "名義曝險上限（永不破例）", minval = 0.1, step = 0.1, group = G_P,
     tooltip = "由『可承受跌幅 ÷ 最壞跳空』決定。NQ 最壞估 12%、容忍 20% → 1.7")
ddNow    = input.float(0.0, "目前距高水位（%，正數）", minval = 0.0, step = 1.0, group = G_P)
ddTol    = input.float(20.0, "可承受回撤（%）", minval = 1.0, step = 1.0, group = G_P)
runway   = input.float(29.0, "現金跑道（月）", minval = 0.0, step = 1.0, group = G_P)
runwayMin= input.float(12.0, "跑道警戒線（月）", minval = 0.0, step = 1.0, group = G_P)

// ── 市場條件：自動計算 ──
volLen   = input.int(20, "短期波動回看", minval = 5, group = G_M)
volBase  = input.int(120, "長期波動基準", minval = 20, group = G_M)
volMult  = input.float(2.0, "波動警戒倍數", minval = 1.0, step = 0.1, group = G_M,
     tooltip = "短期波動 ÷ 長期波動 超過這個倍數 → 市場不正常")
gapPct   = input.float(2.0, "跳空警戒（%）", minval = 0.1, step = 0.5, group = G_M)
lossRun  = input.int(4, "連續下跌警戒（根）", minval = 2, group = G_M)

panelPos = input.string("右上", "面板位置", options = ["右上", "右下", "左上", "左下"], group = G_D)
panelSize= input.string("large", "字體", options = ["small", "normal", "large", "huge"], group = G_D)
showBg   = input.bool(true, "背景警示", group = G_D)

// =============================================================================
// 計算
// =============================================================================
ret     = math.log(close / close[1])
volS    = ta.stdev(ret, volLen) * math.sqrt(252) * 100.0
volL    = ta.stdev(ret, volBase) * math.sqrt(252) * 100.0
volRat  = volL > 0 ? volS / volL : 1.0

gapSize = math.abs(open / close[1] - 1.0) * 100.0

var int downRun = 0
downRun := close < close[1] ? nz(downRun[1]) + 1 : 0

// ── 六個條件，每一個都只會讓你更保守，不會讓你更積極 ──
c1 = expNow > expMax                       // 曝險超過自己設的上限
c2 = volRat > volMult                      // 市場波動異常
c3 = ddNow > ddTol * 0.75                  // 回撤接近容忍線
c4 = gapSize > gapPct                       // 今天有跳空
c5 = downRun >= lossRun                     // 連續下跌
c6 = runway < runwayMin                     // 個人跑道吃緊

nFire = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0) + (c6 ? 1 : 0)

// ── 狀態：只有四級，而且沒有一級叫你「可以加碼」 ──
// 0 = 正常（照既定規則）　1 = 警戒（不加碼）　2 = 停止（不開新倉）　3 = 空城（完全不動）
state = c1 ? 3 : nFire >= 3 ? 3 : nFire == 2 ? 2 : nFire == 1 ? 1 : 0

stName = state == 3 ? "空　城" : state == 2 ? "停　止" : state == 1 ? "警　戒" : "正　常"
stRule = state == 3 ? "今天什麼都不做。關掉電腦。" :
         state == 2 ? "不開新倉。不加碼。只准減。" :
         state == 1 ? "不加碼。維持現有部位。" : "照既定規則執行。不破例。"
stCol  = state == 3 ? color.new(#D32F2F, 0) : state == 2 ? color.new(#F57C00, 0) :
         state == 1 ? color.new(#FBC02D, 0) : color.new(#388E3C, 0)

// =============================================================================
// 顯示
// =============================================================================
bgcolor(showBg and state >= 2 ? color.new(stCol, 85) : na)

posC = panelPos == "右上" ? position.top_right : panelPos == "右下" ? position.bottom_right : panelPos == "左上" ? position.top_left : position.bottom_left
tSize = panelSize == "small" ? size.small : panelSize == "normal" ? size.normal : panelSize == "huge" ? size.huge : size.large

var table tb = table.new(posC, 2, 10, border_width = 2)
row(i, a, b, ca, cb) =>
    table.cell(tb, 0, i, a, bgcolor = color.new(#12141A, 10), text_color = ca,
         text_size = size.normal, text_halign = text.align_left)
    table.cell(tb, 1, i, b, bgcolor = color.new(#12141A, 10), text_color = cb,
         text_size = size.normal, text_halign = text.align_right)

if barstate.islast
    table.cell(tb, 0, 0, stName, bgcolor = stCol, text_color = color.white,
         text_size = tSize, text_halign = text.align_center)
    table.cell(tb, 1, 0, stRule, bgcolor = stCol, text_color = color.white,
         text_size = size.normal, text_halign = text.align_left)

    dim = color.new(#9AA0A6, 0)
    ok  = color.new(#4CAF50, 0)
    bad = color.new(#FF5252, 0)

    row(1, "① 曝險 " + str.tostring(expNow, "#.##") + "x / 上限 " + str.tostring(expMax, "#.##") + "x",
         c1 ? "超限 ✗" : "在線內 ✓", dim, c1 ? bad : ok)
    row(2, "② 波動 " + str.tostring(volS, "#.#") + "% / 基準 " + str.tostring(volL, "#.#") + "%",
         c2 ? str.tostring(volRat, "#.#") + "x 異常 ✗" : str.tostring(volRat, "#.#") + "x 正常 ✓", dim, c2 ? bad : ok)
    row(3, "③ 距高水位 " + str.tostring(ddNow, "#.#") + "% / 容忍 " + str.tostring(ddTol, "#.#") + "%",
         c3 ? "接近 ✗" : "有餘裕 ✓", dim, c3 ? bad : ok)
    row(4, "④ 今日跳空 " + str.tostring(gapSize, "#.##") + "%",
         c4 ? "過大 ✗" : "正常 ✓", dim, c4 ? bad : ok)
    row(5, "⑤ 連續下跌 " + str.tostring(downRun) + " 根",
         c5 ? "過長 ✗" : "正常 ✓", dim, c5 ? bad : ok)
    row(6, "⑥ 現金跑道 " + str.tostring(runway, "#.#") + " 月 / 警戒 " + str.tostring(runwayMin, "#.#"),
         c6 ? "吃緊 ✗" : "充足 ✓", dim, c6 ? bad : ok)
    row(7, "觸發條件數", str.tostring(nFire) + " / 6", dim, nFire >= 2 ? bad : ok)
    row(8, "———————————————", "———————————", dim, dim)
    row(9, "這支指標不會叫你買，也不會叫你賣。", "它只會叫你不要動。", dim, dim)

plotshape(state == 3 and barstate.isconfirmed, "空城", shape.xcross, location.abovebar,
     color.new(#D32F2F, 0), size = size.large)
plotshape(state == 2 and barstate.isconfirmed, "停止", shape.circle, location.abovebar,
     color.new(#F57C00, 0), size = size.small)

plot(state, "狀態（0–3）", display = display.data_window)

alertcondition(state == 3, "空城：完全不動", "空城計：今天什麼都不做")
alertcondition(state >= 2, "停止：不開新倉", "空城計：不開新倉、不加碼")
