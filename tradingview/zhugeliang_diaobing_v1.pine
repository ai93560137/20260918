//@version=6
// =============================================================================
// 智能諸葛亮 · 調兵 v2 — 波動率目標曝險（三段同時對照）
//
// 不擇時、不判斷方向，只調整部位大小：
//   權重 w = 目標波動率 ÷ 實際波動率（上限可設）
//   波動低 → 加碼；波動高 → 減碼
//
// v2 改版：面板同時顯示「前段 / 後段 / 全期」三組統計，
//          不必再手動改日期來回跑。分段日期預設 2013-01-01。
//
// 為什麼是這個方向：
//   本專案先後證明了日內幾何規則沒有優勢（順逆比 = 1.0）、
//   軌道回檔的優勢來自漂移且正在衰減、隔夜溢價的優勢已被市場消化。
//   既然漂移是唯一真實的東西，正確做法就不是擇時進出，
//   而是「一直持有，但用更聰明的大小持有」。
//
// 目標不是打敗買入持有的報酬，而是提高風險調整後報酬與降低回撤。
//
// ⚠️ 三個誠實的細節，缺一個結果就會虛高：
//   1. 權重用「前一根收盤」決定，當根才生效——不偷看未來
//   2. 換手成本按 |Δw| × 成本計算，不是每天固定扣
//   3. 減碼時閒置資金有利息收入、加碼時借款要付利息，兩者都計入
//
// 設定規則：目標波動率設在標的長期實際波動率的 0.6–0.75 倍。
//   設太高 → 權重長期頂在上限，退化成買入持有；設太低 → 曝險不足、報酬被壓縮。
//
// 這支只做量測，不下單。用日線圖執行。
// =============================================================================
indicator("智能諸葛亮 · 調兵 v2｜波動率目標曝險", "調兵 v2", overlay = false)

const string G_V = "① 波動率目標"
const string G_C = "② 成本與利率"
const string G_S = "③ 統計區間"
const string G_D = "④ 顯示"

targetVol = input.float(15.0, "目標年化波動率 %", minval = 1.0, step = 1.0, group = G_V,
     tooltip = "設在標的長期實際波動率的 0.6–0.75 倍。QQQ 約 13–15%、SPY 約 10–13%。")
volLen    = input.int(60, "波動率回看根數", minval = 5, group = G_V,
     tooltip = "20 根約一個月、60 根約一季。60 的換手約為 20 的一半，效率幾乎相同。")
maxW      = input.float(1.0, "最大曝險倍數", minval = 0.1, maxval = 3.0, step = 0.1, group = G_V,
     tooltip = "1.0 = 只減碼不加槓桿。實測優勢完全來自減碼，1.0 的夏普甚至略高於 1.5。")
minW      = input.float(0.0, "最小曝險倍數", minval = 0.0, maxval = 1.0, step = 0.1, group = G_V)
band      = input.float(0.10, "再平衡門檻（權重變動）", minval = 0.0, maxval = 1.0, step = 0.05, group = G_V,
     tooltip = "權重變動超過這個幅度才調整。設 0 = 每天調，換手與成本最高。")

costBps      = input.float(1.0, "單邊成本（bp）", minval = 0.0, step = 0.5, group = G_C,
     tooltip = "成本 = |權重變動| × 此值。權重從 1.0 調到 0.8 = 0.2 的換手。")
cashRate     = input.float(2.0, "閒置資金年利率 %", minval = 0.0, step = 0.5, group = G_C)
borrowSpread = input.float(1.0, "借款利差 %", minval = 0.0, step = 0.5, group = G_C,
     tooltip = "加槓桿時的借款成本 = 閒置資金利率 + 此利差。上限設 1.0 時用不到。")
useDiv       = input.bool(true, "股息計入總報酬", group = G_C,
     tooltip = "用 request.dividends() 直接抓除息金額加回報酬，不依賴圖表的『調整股息』設定。" +
               "這對買入持有較有利（它拿 100% 股息，調兵只拿權重比例），不加會高估調兵。" +
               "無股息資料的商品（期貨、加密）自動視為 0。")
excessSharpe = input.bool(true, "夏普用超額報酬計算（扣無風險利率）", group = G_C,
     tooltip = "比較兩個曝險不同的組合時，這才是公平的算法：調兵有部分資金在現金、" +
               "買入持有全額投資，不扣無風險利率會高估調兵。無風險利率沿用上面的閒置資金年利率。")

startTime   = input.time(timestamp("01 Jan 2000 00:00 +0000"), "起算日期", group = G_S)
splitTime   = input.time(timestamp("01 Jan 2013 00:00 +0000"), "分段日期", group = G_S,
     tooltip = "把統計切成前段與後段。用來檢驗優勢是否隨時代衰減——這是本專案殺掉前兩個題目的關卡。")
endTime     = input.time(timestamp("01 Jan 2100 00:00 +0000"), "結束日期", group = G_S)
barsPerYear = input.int(252, "每年交易日數", minval = 1, group = G_S)

showVT     = input.bool(true, "調兵曲線（全期）", group = G_D, inline = "c")
showBH     = input.bool(true, "買入持有", group = G_D, inline = "c")
showWeight = input.bool(true, "曝險權重（×100）", group = G_D)
colVT      = input.color(#00B4A0, "調兵", group = G_D, inline = "k")
colBH      = input.color(#9E9E9E, "持有", group = G_D, inline = "k")
colBad     = input.color(#FF5252, "落後", group = G_D, inline = "k")
showPanel  = input.bool(true, "統計面板", group = G_D, inline = "p")
panelPos   = input.string("右上", "位置", options = ["右上", "右下", "左上", "左下"], group = G_D, inline = "p")
panelTxt   = input.color(#E8EAED, "文字", group = G_D, inline = "p2")
panelBg    = input.color(color.new(#0F1114, 15), "底色", group = G_D, inline = "p2")
panelSize  = input.string("small", "字體", options = ["tiny", "small", "normal", "large", "huge"],
     group = G_D, inline = "p2")

// =============================================================================
// 報酬與波動率
// =============================================================================
// 股息：除息當根的每股配息，除以前一根收盤 = 當日股息報酬率
divAmt = nz(request.dividends(syminfo.tickerid, dividends.gross, barmerge.gaps_off, barmerge.lookahead_off), 0.0)
divRet = useDiv and not na(close[1]) and close[1] > 0 ? divAmt / close[1] : 0.0

// 總報酬 = 價格報酬 + 股息報酬
r      = na(close[1]) or close[1] <= 0 ? na : close / close[1] - 1.0 + divRet
volAnn = ta.stdev(r, volLen) * math.sqrt(barsPerYear) * 100.0    // 年化波動率 %

okBase = not na(r) and not na(volAnn) and volAnn > 0 and barstate.isconfirmed and
         time >= startTime and time <= endTime

// =============================================================================
// 三個統計桶：0 = 前段、1 = 後段、2 = 全期
// 權重序列三段共用（權重只取決於波動率），差別只在累積的起訖
// =============================================================================
var float w = 1.0

var eVT  = array.new_float(3, 100.0)
var eBH  = array.new_float(3, 100.0)
var pkVT = array.new_float(3, 100.0)
var pkBH = array.new_float(3, 100.0)
var ddVT = array.new_float(3, 0.0)
var ddBH = array.new_float(3, 0.0)
var sVT  = array.new_float(3, 0.0)
var sVT2 = array.new_float(3, 0.0)
var sBH  = array.new_float(3, 0.0)
var sBH2 = array.new_float(3, 0.0)
var sumW = array.new_float(3, 0.0)
var sumTO = array.new_float(3, 0.0)
var nReb = array.new_int(3, 0)
var nObs = array.new_int(3, 0)

add(arr, i, v) => array.set(arr, i, array.get(arr, i) + v)

if okBase
    // ── 1) 用「既有權重」吃這一根的報酬（權重是前一根收盤決定的，不偷看未來）──
    excess = w - 1.0
    rateD  = excess > 0 ? (cashRate + borrowSpread) / 100.0 / barsPerYear : cashRate / 100.0 / barsPerYear
    rPort  = w * r - excess * rateD

    for i = 0 to 2
        active = i == 0 ? time < splitTime : i == 1 ? time >= splitTime : true
        if active
            eV = array.get(eVT, i) * (1.0 + rPort)
            eB = array.get(eBH, i) * (1.0 + r)
            array.set(eVT, i, eV)
            array.set(eBH, i, eB)
            array.set(pkVT, i, math.max(array.get(pkVT, i), eV))
            array.set(pkBH, i, math.max(array.get(pkBH, i), eB))
            pV = array.get(pkVT, i)
            pB = array.get(pkBH, i)
            array.set(ddVT, i, math.max(array.get(ddVT, i), pV > 0 ? (pV - eV) / pV * 100.0 : 0.0))
            array.set(ddBH, i, math.max(array.get(ddBH, i), pB > 0 ? (pB - eB) / pB * 100.0 : 0.0))
            add(sVT,  i, rPort)
            add(sVT2, i, rPort * rPort)
            add(sBH,  i, r)
            add(sBH2, i, r * r)
            add(sumW, i, w)
            array.set(nObs, i, array.get(nObs, i) + 1)

    // ── 2) 收盤後才重新計算權重，供下一根使用 ──
    wNew = math.min(maxW, math.max(minW, targetVol / volAnn))
    if math.abs(wNew - w) > band
        turn = math.abs(wNew - w)
        for i = 0 to 2
            active = i == 0 ? time < splitTime : i == 1 ? time >= splitTime : true
            if active
                array.set(eVT, i, array.get(eVT, i) * (1.0 - turn * costBps / 10000.0))
                add(sumTO, i, turn)
                array.set(nReb, i, array.get(nReb, i) + 1)
        w := wNew

nAll = array.get(nObs, 2)

// =============================================================================
// 畫圖（全期曲線）
// =============================================================================
plot(showVT and nAll > 0 ? array.get(eVT, 2) : na, "調兵",     color.new(colVT, 0), 2)
plot(showBH and nAll > 0 ? array.get(eBH, 2) : na, "買入持有", color.new(colBH, 0), 1)
plot(showWeight and nAll > 0 ? w * 100.0 : na, "曝險權重 ×100",
     color.new(colVT, 70), 1, plot.style_stepline)
hline(100.0, "起點／權重 1.0", color.new(color.gray, 60), hline.style_dotted)

// =============================================================================
// 統計面板：前段 / 後段 / 全期 × 調兵 / 持有
// =============================================================================
posC = panelPos == "右上" ? position.top_right : panelPos == "右下" ? position.bottom_right :
       panelPos == "左上" ? position.top_left : position.bottom_left
dimTxt  = color.new(panelTxt, 45)
txtSize = panelSize == "tiny" ? size.tiny : panelSize == "small" ? size.small :
          panelSize == "large" ? size.large : panelSize == "huge" ? size.huge : size.normal

var table tb = table.new(posC, 7, 10, border_width = 1)
cell(c, row, txt, txtCol) => table.cell(tb, c, row, txt, bgcolor = panelBg, text_color = txtCol,
     text_size = txtSize, text_halign = c == 0 ? text.align_left : text.align_right)
head(c, txt, txtCol) => table.cell(tb, c, 0, txt, bgcolor = color.new(#1E88E5, 10),
     text_color = txtCol, text_size = txtSize)

pct(x) => str.tostring(x, "#.##") + "%"
cagrOf(i, arr) =>
    n = array.get(nObs, i)
    n > 0 ? (math.pow(array.get(arr, i) / 100.0, barsPerYear / math.max(1.0, n)) - 1.0) * 100.0 : na
shOf(i, sa, sa2) =>
    n  = array.get(nObs, i)
    m  = n > 0 ? array.get(sa, i) / n : na
    v  = n > 1 ? math.max(0.0, array.get(sa2, i) / n - m * m) : na
    sd = math.sqrt(v)
    // 超額報酬夏普：兩邊都扣掉同一個無風險利率，曝險不同的組合才能公平比較
    rf = excessSharpe ? cashRate / 100.0 / barsPerYear : 0.0
    sd > 0 ? (m - rf) / sd * math.sqrt(barsPerYear) : na
volOf(i, sa, sa2) =>
    n = array.get(nObs, i)
    m = n > 0 ? array.get(sa, i) / n : na
    v = n > 1 ? math.max(0.0, array.get(sa2, i) / n - m * m) : na
    math.sqrt(v) * math.sqrt(barsPerYear) * 100.0

if showPanel and barstate.islast
    head(0, "調兵 v2", panelTxt)
    head(1, "前·調", colVT)
    head(2, "前·持", colBH)
    head(3, "後·調", colVT)
    head(4, "後·持", colBH)
    head(5, "全·調", colVT)
    head(6, "全·持", colBH)

    cell(0, 1, syminfo.ticker + " · " + timeframe.period + (timeframe.isdaily ? "" : " ⚠ 非日線"),
         timeframe.isdaily ? dimTxt : colBad)
    for i = 0 to 2
        n0  = array.get(nObs, i)
        yrs = n0 / math.max(1.0, barsPerYear * 1.0)
        cell(1 + i * 2, 1, n0 > 0 ? str.tostring(yrs, "#.#") + " 年" : "無資料", n0 > 0 ? dimTxt : colBad)
        cell(2 + i * 2, 1, n0 > 0 ? str.tostring(n0) + " 根" : "—", dimTxt)

    cell(0, 2, "年化報酬", dimTxt)
    cell(0, 3, "年化波動", dimTxt)
    cell(0, 4, excessSharpe ? "夏普(超額)" : "夏普(原始)", dimTxt)
    cell(0, 5, "最大回撤", dimTxt)
    cell(0, 6, "年化÷回撤", dimTxt)
    cell(0, 7, "平均曝險", dimTxt)
    cell(0, 8, "年換手", dimTxt)
    cell(0, 9, "年成本", dimTxt)

    for i = 0 to 2
        cVT = cagrOf(i, eVT)
        cBH = cagrOf(i, eBH)
        sh1 = shOf(i, sVT, sVT2)
        sh2 = shOf(i, sBH, sBH2)
        d1  = array.get(ddVT, i)
        d2  = array.get(ddBH, i)
        k1  = d1 > 0 ? cVT / d1 : na
        k2  = d2 > 0 ? cBH / d2 : na
        n   = array.get(nObs, i)
        yrs = n / math.max(1.0, barsPerYear * 1.0)
        cA = 1 + i * 2      // 調兵欄
        cB = 2 + i * 2      // 持有欄

        cell(cA, 2, n < 1 ? "—" : pct(cVT), cVT >= cBH ? colVT : panelTxt)
        cell(cB, 2, n < 1 ? "—" : pct(cBH), panelTxt)
        cell(cA, 3, n < 1 ? "—" : pct(volOf(i, sVT, sVT2)), panelTxt)
        cell(cB, 3, n < 1 ? "—" : pct(volOf(i, sBH, sBH2)), panelTxt)
        cell(cA, 4, n < 1 ? "—" : str.tostring(sh1, "#.##"), sh1 >= sh2 ? colVT : colBad)
        cell(cB, 4, n < 1 ? "—" : str.tostring(sh2, "#.##"), panelTxt)
        cell(cA, 5, n < 1 ? "—" : pct(d1), d1 <= d2 ? colVT : colBad)
        cell(cB, 5, n < 1 ? "—" : pct(d2), panelTxt)
        cell(cA, 6, n < 1 ? "—" : str.tostring(k1, "#.##"), k1 >= k2 ? colVT : colBad)
        cell(cB, 6, n < 1 ? "—" : str.tostring(k2, "#.##"), panelTxt)
        cell(cA, 7, n < 1 ? "—" : str.tostring(array.get(sumW, i) / n, "#.##") + "x", panelTxt)
        cell(cB, 7, "1.00x", dimTxt)
        cell(cA, 8, n < 1 ? "—" : str.tostring(array.get(nReb, i) / yrs, "#.#") + " 次", panelTxt)
        cell(cB, 8, "0 次", dimTxt)
        cell(cA, 9, n < 1 ? "—" : pct(array.get(sumTO, i) / yrs * costBps / 100.0), panelTxt)
        cell(cB, 9, "—", dimTxt)
