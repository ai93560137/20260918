//@version=6
// =============================================================================
// 智能諸葛亮 · 錦囊 v2 — 一個 HK$20,000 戶口的訓練用回測
//
// v2 的改動只有一個想法：**上限不靠自制力，靠戶口裡沒有更多錢。**
//   戶口只入 HK$20,000 → 就算完全失控，最多也只輸 HK$20,000。
//   所以這支策略的回測要回答的不是「賺不賺錢」，是：
//     ① 一個 20,000 的戶口，跑得完嗎？
//     ② 30 筆一組，一組長什麼樣子？
//
// 規則（定稿，不要改）：
//   XAUUSD M15 · 八陣圖原廠門檻 · 不過濾高週期 · 不過濾波動 · 不過濾時段
//   突破確認 → 下一根開盤進場 → 滿 10 根（2.5 小時）無條件出場 → 無價格停損
//
// 【實測基準 — TradingView Strategy Tester，2018-03-08 → 2026-09-20】
//   1,465 筆（每年 172 筆）  勝率 50.9%  獲利因子 1.361
//   每筆期望值 HK$6.82    單筆最大獲利 HK$851.89   單筆最大虧損 HK$363.86
//   總損益 HK$9,994（8.5 年）→ 一個 HK$20,000 戶口 = +50.0%，年化 +4.88%
//   最大回撤 HK$1,698 = 戶口的 8.5%   單筆最壞 = 戶口的 1.8%
//
//   與獨立的 Python 實作交叉驗證（2022-09→2026-09，750 筆，不同資料源）：
//     單筆最大獲利 845.1（差 0.8%）  單筆最大虧損 365.7（差 0.5%）
//   兩邊對到 1% 以內 —— 規則與 $0.40 成本設定都正確。
//   期望值由 Python 的 9.10 降到 6.82（−25%），是加入 2018–2022 樣本外後的正常衰減。
//   ⚠ 用 6.82 規劃，不要用 9.10。
//
// 【最重要的一個數字：異常值損益 HK$8,644.99 = 總利潤的 86.5%】
//   扣掉異常值後，1,465 筆只剩 HK$1,349（每年 HK$159、每筆 HK$0.92）。
//   Python 端獨立算出同一件事：最賺的 5%（38/752 筆）佔總利潤 186%，
//   其餘 714 筆合計 −HK$5,880。
//   → 這套策略不是靠勝率累積，是靠極少數幾筆吃到大趨勢。
//   → 那幾筆每一筆都要抱滿 10 根才長得出來。提早出場 = 砍掉唯一的利潤來源。
//   → 30 筆一組的期望只有 HK$205，而且中位數是負的。
//      **一組虧錢完全正常。不要用組損益判斷自己做得對不對。**
//
// 【槓桿】1 盎司 = US$4,378 ≈ HK$34,148 名義 ÷ HK$20,000 = 1.71x
//   剛好落在空城計的上限（容忍 20% ÷ 黃金最壞單日 10%）。
//   0.02 手 = 3.41x，超過上限——不該升的理由是槓桿，不是回撤。
//
// ⚠ 回測測的是【規則】，不是【你的紀律】。
//   回測裡你永遠會抱滿 10 根；實盤裡不會。所以真正的指標是那三格打勾。
// =============================================================================
strategy("智能諸葛亮 · 錦囊 v2｜HK$20,000 戶口訓練", "錦囊 v2",
     overlay = true,
     pyramiding = 0,
     currency = currency.HKD,
     initial_capital = 20000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,                      // 1 盎司 = 0.01 手
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.20,                    // 單邊 $0.20/盎司 → 來回 $0.40
     calc_on_every_tick = false,
     process_orders_on_close = false)            // 確認後、下一根開盤成交

const string G_R = "① 規則（原廠值，改了就不是驗證過的那條）"
const string G_A = "② 戶口與訓練"
const string G_W = "③ Webhook 自動交易"
const string G_D = "④ 顯示"

lenTrend    = input.int(60,     "迴歸長度（根）",       minval = 10,  group = G_R)
r2Min       = input.float(0.48, "R² 門檻",             minval = 0.0, maxval = 1.0, step = 0.01, group = G_R)
slopeMin    = input.float(0.025,"斜率門檻（ATR/根）",   minval = 0.0, step = 0.005, group = G_R)
lenRange    = input.int(20,     "區間觀察長度",         minval = 5,   group = G_R)
rangeMaxATR = input.float(3.8,  "區間高度上限（ATR）",  minval = 0.5, step = 0.1,   group = G_R)
rangeMinBars= input.int(8,      "至少維持幾根才算區間", minval = 1,   group = G_R)
boxMaxAge   = input.int(30,     "區間失效根數",         minval = 5,   group = G_R)
bufATR      = input.float(0.25, "突破緩衝（ATR）",      minval = 0.0, step = 0.05,  group = G_R)
confirmBars = input.int(1,      "站穩幾根才確認",       minval = 1, maxval = 5,     group = G_R)
atrLen      = input.int(14,     "ATR 長度",            minval = 2,   group = G_R)
holdBars    = input.int(10,     "持有幾根後無條件出場", minval = 1,   group = G_R,
     tooltip = "10 根 M15 = 2.5 小時。這就是停損。不要再加價格停損——測過四次都變差。")

blockSize   = input.int(30,     "一組幾筆（訓練單位）", minval = 5,   group = G_A)
expPerTrade = input.float(6.82, "每筆期望值（HK$）",     step = 0.01, group = G_A,
     tooltip = "TradingView 實測 1,465 筆的期望值。用來把本組進度換算成期望值，提醒你組損益本身沒有判定意義。")
notionalHKD = input.float(34148,"一口的名義（HK$）",    minval = 1, step = 1000, group = G_A,
     tooltip = "1 盎司 × 金價 × 匯率。用來算槓桿。金價變動時更新。")
levCap      = input.float(1.70, "槓桿上限（空城計）",   minval = 0.1, step = 0.1, group = G_A,
     tooltip = "容忍回撤 20% ÷ 黃金最壞單日 10% = 2.0；取保守值 1.7。")

// ── Webhook（對沖 / Hedging 帳戶專用寫法）──
//
// ⚠ 為什麼不能沿用 {{strategy.order.action}}：
//   平倉單的 action 是「反向」（多單平倉 → sell）。淨額帳戶會沖銷，對沖帳戶
//   會【另開一張反向單】，部位永遠不平、無限累積。
//   所以進場與平倉必須送出【不同的 action 值】，由 Pine 這邊決定。
//
// 設定方式：
//   1. 憑證填在下面這些 input 裡（存在圖表設定，不會寫進原始碼）
//   2. 「平倉的 action 值」要填你的橋接服務認得的那個字 —— 查它的文件，
//      常見有 close / closelong+closeshort / exit / flat。填錯 = 平不掉。
//   3. 建立警報：條件選「錦囊 v2」→ 勾「僅訂單執行」→ 週期 15 分
//      → 訊息欄只填 {{strategy.order.alert_message}}（整串 JSON 由此帶出）
//      → 通知填 webhook URL
//
// ⚠ 上線前一定要在【模擬倉】跑滿 3 天，確認每筆進場後 2.5 小時真的回到零持倉。
whUser   = input.string("",           "username",     group = G_W)
whAcct   = input.string("1",          "account",      group = G_W)
whKey    = input.string("",           "api_key",      group = G_W,
     tooltip = "填在這裡，不要寫進原始碼或截圖外流。外流過就立刻重置。")
whBroker = input.string("metatrader", "broker",       group = G_W)
whType   = input.string("demo",       "account_type", options = ["demo", "real"], group = G_W,
     tooltip = "先 demo。確認平倉正常之後再改 real。")
whSym    = input.string("XAUUSD",     "symbol",       group = G_W)
whSize   = input.string("0.01",       "size（手）",    group = G_W,
     tooltip = "0.01 手 = 1.71x 槓桿（20,000 戶口），剛好在空城計上限。0.02 = 3.41x，超標。")
whStrat  = input.string("910",        "strategy",     group = G_W)
whCmt    = input.string("jinnang M15","comment",      group = G_W)
vBuy     = input.string("buy",        "做多進場的 action 值",  group = G_W)
vSell    = input.string("sell",       "做空進場的 action 值",  group = G_W)
vClose   = input.string("close",      "平倉的 action 值 ★",    group = G_W,
     tooltip = "★ 對沖帳戶的成敗就在這一格。查你橋接服務的文件，不要用 sell / buy。")

showPanel = input.bool(true,  "顯示面板", group = G_D)
showBox   = input.bool(true,  "畫出橫行區間", group = G_D)

// =============================================================================
// 狀態
// =============================================================================
atrV  = ta.atr(atrLen)
slope = ta.linreg(close, lenTrend, 0) - ta.linreg(close, lenTrend, 1)
corr  = ta.correlation(close, bar_index, lenTrend)
r2    = na(corr) ? 0.0 : corr * corr
sN    = atrV > 0 ? slope / atrV : 0.0
hiN   = ta.highest(high, lenRange)
loN   = ta.lowest(low,  lenRange)
wATR  = atrV > 0 ? (hiN - loN) / atrV : na

isUp  = r2 >= r2Min and sN >=  slopeMin
isDn  = r2 >= r2Min and sN <= -slopeMin
isRng = not isUp and not isDn and wATR <= rangeMaxATR
st    = isUp ? 1 : isDn ? -1 : isRng ? 0 : 2

rangeHold = nz(ta.barssince(st != 0), bar_index)
rangeOK   = st == 0 and rangeHold >= rangeMinBars

var float boxTop = na
var float boxBot = na
var bool  boxLive = false
var int   lastRangeBar = na

if barstate.isconfirmed
    if rangeOK
        boxTop := hiN[1]
        boxBot := loN[1]
        boxLive := true
        lastRangeBar := bar_index
    else if boxLive and not na(lastRangeBar) and bar_index - lastRangeBar > boxMaxAge
        boxLive := false

upLevel = boxLive ? boxTop + bufATR * atrV : na
dnLevel = boxLive ? boxBot - bufATR * atrV : na

var int pendDir = 0
var int pendCnt = 0
if barstate.isconfirmed
    dRaw = boxLive and not na(upLevel) and close > upLevel ? 1 :
           boxLive and not na(dnLevel) and close < dnLevel ? -1 : 0
    pendCnt := dRaw != 0 and dRaw == pendDir ? pendCnt + 1 : dRaw != 0 ? 1 : 0
    pendDir := dRaw

confirmUp = barstate.isconfirmed and pendDir ==  1 and pendCnt == confirmBars
confirmDn = barstate.isconfirmed and pendDir == -1 and pendCnt == confirmBars

// =============================================================================
// 進出場
// =============================================================================
var int barsIn = 0
barsIn := strategy.position_size != 0 ? nz(barsIn[1]) + 1 : 0

// JSON 組裝：所有值都以字串送出（與 Webhook8 一類橋接的格式一致）
kv(k, v) => "\"" + k + "\": \"" + v + "\""
mkMsg(act) =>
    "{" + kv("username", whUser) + ", " + kv("account", whAcct) + ", " +
     kv("api_key", whKey) + ", " + kv("broker", whBroker) + ", " +
     kv("account_type", whType) + ", " + kv("symbol", whSym) + ", " +
     kv("action", act) + ", " + kv("size", whSize) + ", " +
     kv("strategy", whStrat) + ", " + kv("comment", whCmt) + "}"

msgLong  = mkMsg(vBuy)
msgShort = mkMsg(vSell)
msgExit  = mkMsg(vClose)

if confirmUp and strategy.position_size == 0
    strategy.entry("多", strategy.long, alert_message = msgLong)
    boxLive := false
if confirmDn and strategy.position_size == 0
    strategy.entry("空", strategy.short, alert_message = msgShort)
    boxLive := false

if strategy.position_size != 0 and barsIn >= holdBars
    strategy.close_all("時間到", alert_message = msgExit)

// =============================================================================
// 戶口監控與 30 筆分組
// =============================================================================
var float minEq    = na
var float blkStart = na
var int   blkDone  = 0
var int   blkWin   = 0
var float blkBest  = na
var float blkWorst = na
var int   lastCount = 0
var bool  blown    = false

minEq    := na(minEq)    ? strategy.equity : math.min(minEq, strategy.equity)
blkStart := na(blkStart) ? strategy.initial_capital : blkStart
blown    := blown or strategy.equity <= 0

nTr = strategy.closedtrades
if nTr > lastCount
    lastCount := nTr
    if nTr % blockSize == 0
        pnl = strategy.equity - blkStart
        blkDone  := blkDone + 1
        blkWin   := pnl > 0 ? blkWin + 1 : blkWin
        blkBest  := na(blkBest)  ? pnl : math.max(blkBest,  pnl)
        blkWorst := na(blkWorst) ? pnl : math.min(blkWorst, pnl)
        blkStart := strategy.equity

inBlk   = nTr % blockSize
blkPnL  = strategy.equity - blkStart
lev     = strategy.initial_capital > 0 ? notionalHKD / strategy.initial_capital : na
eqPct   = strategy.initial_capital > 0 ? strategy.equity / strategy.initial_capital * 100 : na
minPct  = strategy.initial_capital > 0 ? minEq / strategy.initial_capital * 100 : na

// =============================================================================
// 顯示
// =============================================================================
pU = plot(showBox and boxLive ? boxTop : na, "區間上緣", color.new(#26A69A, 30), 1, plot.style_linebr)
pD = plot(showBox and boxLive ? boxBot : na, "區間下緣", color.new(#EF5350, 30), 1, plot.style_linebr)
fill(pU, pD, showBox and boxLive ? color.new(#78909C, 92) : na)

plotshape(confirmUp, "向上突破", shape.triangleup,   location.belowbar, color.new(#26A69A, 0), size = size.tiny)
plotshape(confirmDn, "向下跌破", shape.triangledown, location.abovebar, color.new(#EF5350, 0), size = size.tiny)

var table tb = table.new(position.top_right, 2, 11, border_width = 1)
bgC  = color.new(#12141A, 8)
dimC = color.new(#9AA0A6, 25)
valC = color.new(#E8EAED, 0)
okC  = color.new(#4CAF50, 0)
badC = color.new(#FF5252, 0)
warnC= color.new(#FBC02D, 0)

row(i, k, v, c) =>
    table.cell(tb, 0, i, k, bgcolor = bgC, text_color = dimC, text_halign = text.align_left)
    table.cell(tb, 1, i, v, bgcolor = bgC, text_color = c,    text_halign = text.align_right)

if showPanel and barstate.islast
    posTxt = strategy.position_size > 0 ? "多｜" + str.tostring(holdBars - barsIn) + " 根後出" :
             strategy.position_size < 0 ? "空｜" + str.tostring(holdBars - barsIn) + " 根後出" : "空手"
    row(0, "錦囊 v2 · HK$" + str.tostring(strategy.initial_capital, "#") + " 戶口", posTxt,
         strategy.position_size != 0 ? warnC : dimC)
    row(1, "權益", "HK$" + str.tostring(strategy.equity, "#") + "　(" + str.tostring(eqPct, "#.#") + "%)",
         strategy.equity >= strategy.initial_capital ? okC : badC)
    row(2, "最低權益（戶口有沒有撐住）", "HK$" + str.tostring(minEq, "#") + "　(" + str.tostring(minPct, "#.#") + "%)",
         blown ? badC : minPct < 50 ? warnC : okC)
    row(3, "最大回撤", "HK$" + str.tostring(strategy.max_drawdown, "#"), valC)
    row(4, "槓桿（名義 ÷ 戶口）", str.tostring(lev, "#.##") + "x / 上限 " + str.tostring(levCap, "#.##") + "x",
         lev > levCap ? badC : okC)
    row(5, "———————————", "———————————", dimC)
    row(6, "交易數 / 勝率", str.tostring(nTr) + " / " +
         (nTr > 0 ? str.tostring(strategy.wintrades / nTr * 100, "#.#") + "%" : "—"), valC)
    row(7, "本組進度", str.tostring(inBlk) + " / " + str.tostring(blockSize) +
         "　(" + (blkPnL >= 0 ? "+" : "") + str.tostring(blkPnL, "#") +
         "　期望 " + str.tostring(inBlk * expPerTrade, "#") + ")",
         blkPnL >= 0 ? okC : badC)
    row(8, "已完成組數（正 / 全部）", str.tostring(blkWin) + " / " + str.tostring(blkDone),
         blkDone > 0 and blkWin * 2 >= blkDone ? okC : warnC)
    row(9, "單組 最好 / 最壞",
         (na(blkBest) ? "—" : str.tostring(blkBest, "#")) + " / " +
         (na(blkWorst) ? "—" : str.tostring(blkWorst, "#")), valC)
    row(10, "86.5% 利潤來自異常值。", "組虧錢是常態 — 看打勾，不看損益。", dimC)

plot(strategy.equity,  "權益",     display = display.data_window)
plot(minEq,            "最低權益", display = display.data_window)
plot(inBlk,            "本組第幾筆", display = display.data_window)
plot(blkPnL,           "本組損益", display = display.data_window)

alertcondition(confirmUp, "錦囊：向上突破", "XAUUSD M15 向上突破確認 → 下一根開盤做多，抱滿 10 根")
alertcondition(confirmDn, "錦囊：向下跌破", "XAUUSD M15 向下跌破確認 → 下一根開盤做空，抱滿 10 根")
