//@version=6
// =============================================================================
// 智能諸葛亮 · 八陣圖 v1 — 橫行 / 突破 / 上升（下降）軌道
//
// 「智能諸葛亮」= 整套系統的總名；「八陣圖」= 盤勢形態辨識模組（本檔）。
// 之後的進出場、回測、掃描模組另以「智能諸葛亮 · ○○」命名，共用同一套狀態定義。
//
// 目的：把「肉眼看圖」的三種判斷寫成可調門檻的數字，畫在圖上供人工校準。
// 這支腳本只畫圖與發警報，不下單、不做回測。
//
// 三個狀態的定義
//   軌道(TREND)：線性迴歸斜率夠大（以 ATR 標準化）且 R² 夠高（價格貼著軌道走）
//   橫行(RANGE)：非軌道，且最近 N 根的高低區間高度 ≤ ATR × 門檻，並維持一定根數
//   過渡(NEUTRAL)：兩者都不是，不發訊號
//
// 突破 = 橫行區間成立 → 收盤越過區間邊緣 + ATR 緩衝 → 站穩 N 根確認
// 假突破 = 確認後 M 根內收盤又跌回區間內（事後標記，用來算準確率）
//
// 防未來函數：高週期一律取「已收盤」的值（lookahead_on + [1] 的標準寫法）；
// 所有狀態機只在 K 線收盤時推進（barstate.isconfirmed），與實盤警報一致。
// 警報請務必選「Once Per Bar Close」。
// =============================================================================
indicator("智能諸葛亮 · 八陣圖 v1｜橫行 · 突破 · 軌道", "八陣圖 v1", overlay = true, max_labels_count = 500)

const string G_T = "① 軌道（趨勢）判定"
const string G_R = "② 橫行判定"
const string G_B = "③ 突破判定"
const string G_H = "④ 高週期過濾"
const string G_S = "⑤ 時段過濾（美股）"
const string G_D = "⑥ 顯示"

// ── ① 軌道 ───────────────────────────────────────────────────────────────────
lenTrend = input.int(60,    "迴歸長度（根）",          minval = 10, group = G_T,
     tooltip = "用最近這麼多根做線性迴歸。60 根 ≈ 5 分鐘圖的 5 小時。")
r2Min    = input.float(0.60, "R² 門檻（軌道乾淨度）",   minval = 0.0, maxval = 1.0, step = 0.05, group = G_T,
     tooltip = "R² 就是肉眼講的『這條軌道漂不漂亮』。0.6 起跳算明顯，0.8 以上是教科書級。")
slopeMin = input.float(0.03, "斜率門檻（ATR/根）",      minval = 0.0, step = 0.01, group = G_T,
     tooltip = "每根 K 線平均走多少個 ATR 才算有方向。用 ATR 標準化，換標的不必重調。")
chanMult = input.float(2.0,  "通道寬度（殘差 σ 倍數）", minval = 0.5, step = 0.5, group = G_T)
atrLen   = input.int(14,     "ATR 長度",                minval = 2,  group = G_T)

// ── ② 橫行 ───────────────────────────────────────────────────────────────────
lenRange     = input.int(20,   "區間觀察長度（根）",        minval = 5, group = G_R)
rangeMaxATR  = input.float(4.0, "區間高度上限（ATR 倍數）", minval = 0.5, step = 0.5, group = G_R,
     tooltip = "最近 N 根的最高減最低，若小於 ATR × 此值，視為被壓縮的橫行。")
rangeMinBars = input.int(8,    "至少維持幾根才算有效區間",  minval = 1, group = G_R)
boxMaxAge    = input.int(50,   "區間失效根數",              minval = 5, group = G_R,
     tooltip = "橫行結束後，這個區間還能當突破基準多久。超過就作廢。")

// ── ③ 突破 ───────────────────────────────────────────────────────────────────
bufATR      = input.float(0.25, "突破緩衝（ATR 倍數）", minval = 0.0, step = 0.05, group = G_B,
     tooltip = "收盤要越過區間邊緣再加這麼多 ATR 才算數，過濾貼邊的假動作。")
confirmBars = input.int(1,      "站穩幾根才算確認",     minval = 1, maxval = 5, group = G_B)
useVol      = input.bool(true,  "需要量能配合",         group = G_B)
volMult     = input.float(1.5,  "量能 ≥ 均量 ×",        minval = 1.0, step = 0.1, group = G_B)
volLen      = input.int(20,     "均量長度",             minval = 5, group = G_B)
failBars    = input.int(10,     "幾根內跌回區間視為假突破", minval = 1, group = G_B)

// ── ④ 高週期 ─────────────────────────────────────────────────────────────────
useHTF = input.bool(true,   "高週期方向必須一致", group = G_H)
htfSel = input.string("自動", "高週期",            group = G_H,
     options = ["自動", "5", "15", "30", "60", "120", "240", "D", "W"])

// ── ⑤ 時段（美股） ───────────────────────────────────────────────────────────
useSess = input.bool(true,       "只在指定時段發訊號", group = G_S)
sessStr = input.session("0945-1545", "可發訊號時段",   group = G_S,
     tooltip = "預設避開開盤與收盤各 15 分鐘的亂流。24 小時商品請設 0000-2400 或關閉此項。")
sessTZ  = input.string("America/New_York", "時區", group = G_S,
     options = ["America/New_York", "America/Chicago", "Asia/Hong_Kong", "Asia/Tokyo", "Europe/London", "UTC"])

// ── ⑥ 顯示：顏色與字體 ───────────────────────────────────────────────────────
showBg    = input.bool(true, "狀態背景色", group = G_D, inline = "bg")
bgOpacity = input.int(70, "透明度", minval = 0, maxval = 95, step = 5, group = G_D, inline = "bg",
     tooltip = "數字越小顏色越重。0＝實心、95＝幾乎看不見。淺色主題建議 60–75，深色主題建議 75–85。")
colUp = input.color(#00B4A0, "上升", group = G_D, inline = "cs")
colDn = input.color(#FF5252, "下降", group = G_D, inline = "cs")
colRg = input.color(#FFA726, "橫行", group = G_D, inline = "cs",
     tooltip = "三個狀態的主色，背景、通道、區間線、突破標記全部跟著這裡走。")

showChan  = input.bool(true, "迴歸通道",     group = G_D, inline = "d1")
showBox   = input.bool(true, "區間邊緣",     group = G_D, inline = "d1")
showMarks = input.bool(true, "突破標記",     group = G_D, inline = "d1")
colFail   = input.color(#E040FB, "假突破標記顏色", group = G_D)

showArrow = input.bool(true, "順勢 K 線箭頭", group = G_D, inline = "ar",
     tooltip = "上升軌道中的每根陽線（收 > 開）在下方標向上箭頭；下降軌道中的每根陰線標向下箭頭。" +
               "只在軌道狀態出現，橫行與過渡不標。")
arrowSize = input.string("tiny", "大小", options = ["tiny", "small", "normal"], group = G_D, inline = "ar")
arrowBody = input.float(0.0, "實體佔全長 ≥", minval = 0.0, maxval = 0.9, step = 0.05, group = G_D,
     tooltip = "0 = 所有同向 K 線都標。調高可只標實體夠長的 K 線（例如 0.5 = 實體至少佔整根的一半），畫面比較乾淨。")

showPanel = input.bool(true, "狀態面板", group = G_D, inline = "p0")
panelPos  = input.string("右上", "位置", group = G_D, inline = "p0",
     options = ["右上", "右中", "右下", "左上", "左中", "左下"])
panelTxt  = input.color(#E8EAED, "面板文字", group = G_D, inline = "p1")
panelBg   = input.color(color.new(#0F1114, 15), "面板背景", group = G_D, inline = "p1")
panelHead = input.color(color.new(#1E88E5, 10), "標題底色", group = G_D, inline = "p2")
panelSize = input.string("normal", "字體大小", options = ["tiny", "small", "normal", "large", "huge"],
     group = G_D, inline = "p2",
     tooltip = "淺色主題請把「面板文字」改成深色（例如 #1A1A1A）、「面板背景」改成淺色。")

// =============================================================================
// 核心：狀態計算（同一份程式碼給本週期與高週期共用）
// =============================================================================
f_state() =>
    _atr   = ta.atr(atrLen)
    _lr    = ta.linreg(close, lenTrend, 0)
    _slope = _lr - ta.linreg(close, lenTrend, 1)
    _corr  = ta.correlation(close, bar_index, lenTrend)
    _r2    = na(_corr) ? 0.0 : _corr * _corr
    _sN    = _atr > 0 ? _slope / _atr : 0.0          // 斜率標準化成「ATR/根」
    _hi    = ta.highest(high, lenRange)
    _lo    = ta.lowest(low,  lenRange)
    _wATR  = _atr > 0 ? (_hi - _lo) / _atr : na      // 區間高度，單位 ATR
    _sd    = ta.stdev(close, lenTrend)
    _resid = _sd * math.sqrt(math.max(0.0, 1.0 - _r2))   // 迴歸殘差 σ（通道半寬用）
    _up    = _r2 >= r2Min and _sN >=  slopeMin
    _dn    = _r2 >= r2Min and _sN <= -slopeMin
    _rng   = not _up and not _dn and _wATR <= rangeMaxATR
    _st    = _up ? 1 : _dn ? -1 : _rng ? 0 : 2       // 1 上升軌道 / -1 下降軌道 / 0 橫行 / 2 過渡
    [_st, _sN, _r2, _wATR, _hi, _lo, _lr, _atr, _resid]

[st, slopeN, r2, wATR, hiN, loN, lrVal, atr, resid] = f_state()

// 高週期：只取已收盤的值 → 不會隨盤中價格跳動（非重繪）
f_htf() =>
    [_st, _sN, _r2, _w, _hi, _lo, _lr, _atr, _rd] = f_state()
    [_st[1], _sN[1], _r2[1]]

secs   = timeframe.in_seconds(timeframe.period)
autoTF = secs <= 300 ? "60" : secs <= 900 ? "240" : secs <= 3600 ? "D" : secs <= 14400 ? "W" : "M"
htfTF  = htfSel == "自動" ? autoTF : htfSel

[htfSt, htfSlope, htfR2] = request.security(syminfo.tickerid, htfTF, f_htf(),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

htfTooSmall = timeframe.in_seconds(htfTF) < secs
htfUpOK = not useHTF or htfSt ==  1
htfDnOK = not useHTF or htfSt == -1

// =============================================================================
// 橫行區間鎖存：成立時跟著更新，結束後凍結，當作突破的基準線
// =============================================================================
rangeRaw  = st == 0
rangeHold = nz(ta.barssince(not rangeRaw), bar_index)
rangeOK   = rangeRaw and rangeHold >= rangeMinBars

var float boxTop  = na
var float boxBot  = na
var bool  boxLive = false
var int   lastRangeBar = na

confirmed = barstate.isconfirmed          // 狀態機只在收盤推進

if confirmed
    if rangeOK
        boxTop  := hiN[1]                 // 用前一根為止的極值，突破當根才不會自己把箱子撐大
        boxBot  := loN[1]
        boxLive := true
        lastRangeBar := bar_index
    else if boxLive and not na(lastRangeBar) and bar_index - lastRangeBar > boxMaxAge
        boxLive := false                  // 區間放太久失去意義

// =============================================================================
// 突破：觸發 → 站穩確認 → 事後判定真假
// =============================================================================
upLevel = boxLive ? boxTop + bufATR * atr : na
dnLevel = boxLive ? boxBot - bufATR * atr : na

volAvg   = ta.sma(volume, volLen)
volValid = not na(volume) and volume > 0 and not na(volAvg) and volAvg > 0
volOK    = not useVol or not volValid or volume >= volAvg * volMult   // 無量資料的商品自動略過此關

inSess = (timeframe.isdwm or not useSess) ? true : not na(time(timeframe.period, sessStr, sessTZ))

rawUp = boxLive and not na(upLevel) and close > upLevel and volOK and inSess and htfUpOK
rawDn = boxLive and not na(dnLevel) and close < dnLevel and volOK and inSess and htfDnOK

var int   pendDir = 0
var float pendLvl = na
var int   pendCnt = 0

var int   brkDir   = 0
var int   brkBar   = na
var float brkTop   = na
var float brkBot   = na
var bool  brkOpen  = false

var int cntUp   = 0
var int cntDn   = 0
var int cntFail = 0
var int cntHold = 0
var int barsUp  = 0
var int barsDn  = 0
var int barsRg  = 0
var int barsNt  = 0

bool confirmUp = false
bool confirmDn = false
bool failMark  = false

if confirmed
    // 狀態佔比統計（門檻是否合理的第一個檢查點）
    barsUp += st ==  1 ? 1 : 0
    barsDn += st == -1 ? 1 : 0
    barsRg += st ==  0 ? 1 : 0
    barsNt += st ==  2 ? 1 : 0

    // 待確認的突破
    if pendDir == 0
        if rawUp
            pendDir := 1
            pendLvl := upLevel
            pendCnt := 1
        else if rawDn
            pendDir := -1
            pendLvl := dnLevel
            pendCnt := 1
    else if pendDir == 1
        if close > pendLvl
            pendCnt += 1
        else
            pendDir := 0                  // 沒站住，作廢重來
    else if pendDir == -1
        if close < pendLvl
            pendCnt += 1
        else
            pendDir := 0

    // 確認
    if pendDir != 0 and pendCnt >= confirmBars
        if pendDir == 1
            confirmUp := true
            cntUp += 1
        else
            confirmDn := true
            cntDn += 1
        brkDir  := pendDir
        brkBar  := bar_index
        brkTop  := boxTop
        brkBot  := boxBot
        brkOpen := true
        boxLive := false                  // 這個區間用掉了
        pendDir := 0
        pendCnt := 0

    // 事後判定真假突破
    if brkOpen and not na(brkBar) and bar_index > brkBar
        if brkDir == 1 and close < brkTop
            cntFail += 1
            failMark := true
            brkOpen  := false
        else if brkDir == -1 and close > brkBot
            cntFail += 1
            failMark := true
            brkOpen  := false
        else if bar_index - brkBar >= failBars
            cntHold += 1
            brkOpen := false

// =============================================================================
// 畫圖
// =============================================================================
bgcolor(showBg ? (st == 1 ? color.new(colUp, bgOpacity) :
                  st == -1 ? color.new(colDn, bgOpacity) :
                  st == 0 ? color.new(colRg, math.min(95, bgOpacity + 5)) : na) : na, title = "狀態背景")

chanCol = st == 1 ? colUp : colDn
showCh  = showChan and (st == 1 or st == -1)
plot(showCh ? lrVal : na,                    "迴歸中線", color.new(chanCol, 0),  2, plot.style_linebr)
plot(showCh ? lrVal + chanMult * resid : na, "通道上緣", color.new(chanCol, 45), 1, plot.style_linebr)
plot(showCh ? lrVal - chanMult * resid : na, "通道下緣", color.new(chanCol, 45), 1, plot.style_linebr)

plot(showBox and boxLive ? boxTop : na, "區間上緣", color.new(colRg, 10), 1, plot.style_linebr)
plot(showBox and boxLive ? boxBot : na, "區間下緣", color.new(colRg, 10), 1, plot.style_linebr)

plotshape(showMarks and confirmUp, "向上突破", shape.triangleup,   location.belowbar,
     color.new(colUp, 0), size = size.small, text = "突破", textcolor = color.new(colUp, 0))
plotshape(showMarks and confirmDn, "向下突破", shape.triangledown, location.abovebar,
     color.new(colDn, 0), size = size.small, text = "跌破", textcolor = color.new(colDn, 0))
plotshape(showMarks and failMark,  "假突破",   shape.xcross,       location.top,
     color.new(colFail, 0), size = size.tiny)

// ── 順勢 K 線箭頭：上升軌道的陽線 ↑、下降軌道的陰線 ↓ ────────────────────────
barRange = high - low
bodyPct  = barRange > 0 ? math.abs(close - open) / barRange : 0.0
bodyOK   = bodyPct >= arrowBody
arwSize  = arrowSize == "small" ? size.small : arrowSize == "normal" ? size.normal : size.tiny
arrowUp  = showArrow and st ==  1 and close > open and bodyOK
arrowDn  = showArrow and st == -1 and close < open and bodyOK
plotshape(arrowUp, "順勢陽線 ↑", shape.arrowup,   location.belowbar, color.new(colUp, 0), size = arwSize)
plotshape(arrowDn, "順勢陰線 ↓", shape.arrowdown, location.abovebar, color.new(colDn, 0), size = arwSize)

// ── 狀態面板 ─────────────────────────────────────────────────────────────────
stName(v) => v == 1 ? "上升軌道 ▲" : v == -1 ? "下降軌道 ▼" : v == 0 ? "橫行 ▬" : "過渡 ～"
stCol(v)  => v == 1 ? colUp : v == -1 ? colDn : v == 0 ? colRg : color.new(panelTxt, 45)

txtSize = panelSize == "tiny" ? size.tiny : panelSize == "small" ? size.small :
          panelSize == "large" ? size.large : panelSize == "huge" ? size.huge : size.normal
posC    = panelPos == "右上" ? position.top_right : panelPos == "右中" ? position.middle_right :
          panelPos == "右下" ? position.bottom_right : panelPos == "左上" ? position.top_left :
          panelPos == "左中" ? position.middle_left : position.bottom_left
dimTxt  = color.new(panelTxt, 45)

var table tb = table.new(posC, 2, 11, border_width = 1)

// 左欄（欄位名稱）與右欄（數值）的統一樣式
cellK(row, txt) => table.cell(tb, 0, row, txt, bgcolor = panelBg, text_color = dimTxt,
     text_size = txtSize, text_halign = text.align_left)
cellV(row, txt, col) => table.cell(tb, 1, row, txt, bgcolor = panelBg, text_color = col,
     text_size = txtSize, text_halign = text.align_right)

if showPanel and barstate.islast
    totalBars = math.max(1, barsUp + barsDn + barsRg + barsNt)
    brkAll    = cntUp + cntDn
    resolved  = cntFail + cntHold
    failPct   = resolved > 0 ? cntFail / resolved * 100 : na
    distUp    = boxLive and not na(upLevel) ? (upLevel - close) / atr : na
    distDn    = boxLive and not na(dnLevel) ? (close - dnLevel) / atr : na

    table.cell(tb, 0, 0, "八陣圖 v1", bgcolor = panelHead, text_color = panelTxt, text_size = txtSize)
    table.cell(tb, 1, 0, syminfo.ticker + " · " + timeframe.period,
         bgcolor = panelHead, text_color = panelTxt, text_size = txtSize)

    cellK(1, "本週期")
    cellV(1, stName(st), stCol(st))

    cellK(2, "高週期 " + htfTF + (htfTooSmall ? " ⚠" : ""))
    cellV(2, useHTF ? stName(htfSt) + "  R²=" + str.tostring(htfR2, "#.##") +
         "  斜率=" + str.tostring(htfSlope, "#.###") : "（未啟用）",
         useHTF ? stCol(htfSt) : dimTxt)

    cellK(3, "斜率 ATR/根")
    cellV(3, str.tostring(slopeN, "#.###") + "  (門檻 ±" + str.tostring(slopeMin, "#.##") + ")",
         math.abs(slopeN) >= slopeMin ? panelTxt : dimTxt)

    cellK(4, "R²")
    cellV(4, str.tostring(r2, "#.##") + "  (門檻 " + str.tostring(r2Min, "#.##") + ")",
         r2 >= r2Min ? panelTxt : dimTxt)

    cellK(5, "區間高度 ATR")
    cellV(5, str.tostring(wATR, "#.#") + "  (上限 " + str.tostring(rangeMaxATR, "#.#") + ")",
         wATR <= rangeMaxATR ? panelTxt : dimTxt)

    cellK(6, "有效區間")
    cellV(6, boxLive ? str.tostring(boxBot, format.mintick) + " ~ " + str.tostring(boxTop, format.mintick) : "無",
         boxLive ? colRg : dimTxt)

    cellK(7, "距突破 (ATR)")
    cellV(7, boxLive ? "↑" + str.tostring(distUp, "#.##") + "  ↓" + str.tostring(distDn, "#.##") : "—",
         boxLive ? panelTxt : dimTxt)

    cellK(8, "狀態佔比")
    cellV(8, "▲" + str.tostring(barsUp * 100.0 / totalBars, "#") + "%  ▼" +
         str.tostring(barsDn * 100.0 / totalBars, "#") + "%  ▬" +
         str.tostring(barsRg * 100.0 / totalBars, "#") + "%  ～" +
         str.tostring(barsNt * 100.0 / totalBars, "#") + "%", panelTxt)

    cellK(9, "突破次數")
    cellV(9, "↑" + str.tostring(cntUp) + "  ↓" + str.tostring(cntDn) + "  共" + str.tostring(brkAll), panelTxt)

    cellK(10, "假突破率")
    cellV(10, resolved > 0 ? str.tostring(failPct, "#") + "%  (" + str.tostring(cntFail) + "/" +
         str.tostring(resolved) + ")" : "資料不足",
         na(failPct) ? dimTxt : failPct > 50 ? colDn : colUp)

// =============================================================================
// 警報（TradingView 建立警報時請選 Once Per Bar Close）
// =============================================================================
alertcondition(confirmUp, "橫行向上突破", "{{ticker}} {{interval}} 橫行區間向上突破確認 @ {{close}}")
alertcondition(confirmDn, "橫行向下跌破", "{{ticker}} {{interval}} 橫行區間向下跌破確認 @ {{close}}")
alertcondition(st == 1 and st[1] != 1,  "進入上升軌道", "{{ticker}} {{interval}} 進入上升軌道")
alertcondition(st == -1 and st[1] != -1, "進入下降軌道", "{{ticker}} {{interval}} 進入下降軌道")
alertcondition(st == 0 and st[1] != 0,  "進入橫行",     "{{ticker}} {{interval}} 進入橫行整理")

if confirmUp or confirmDn
    alert(str.format("{0} {1} {2} @ {3}｜R²={4,number,#.##} 斜率={5,number,#.###} 高週期={6}",
         syminfo.ticker, timeframe.period, confirmUp ? "向上突破" : "向下跌破",
         str.tostring(close, format.mintick), r2, slopeN, stName(htfSt)), alert.freq_once_per_bar_close)
