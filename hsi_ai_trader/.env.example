# 複製做 .env 再填

# --- Futu OpenD ---
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
TRD_ENV=SIMULATE            # 試完冇問題先改 REAL
FUTU_ACC_ID=0               # 0 = 自動揀第一個期貨戶口
FUTU_TRADE_PASSWORD=        # 留空 = 已喺 OpenD 介面解鎖交易

# --- Claude ---
ANTHROPIC_API_KEY=            # 只填喺部機 .env，唔好 commit
CLAUDE_MODEL=claude-sonnet-5-5
DECISION_INTERVAL_MIN=5

# --- 硬性風控（AI 無權超越）---
MAX_QTY=1
DAILY_LOSS_LIMIT=10000
MAX_STOP_POINTS=150         # 每張單止蝕最多 150 點 = HK$1,500
MIN_STOP_POINTS=20
MAX_TRADES_PER_DAY=20
NO_ENTRY_BEFORE_CLOSE_MIN=10
FLATTEN_BEFORE_NIGHT_CLOSE=true
FLATTEN_BEFORE_NIGHT_CLOSE_MIN=10
SLIPPAGE_POINTS=3
