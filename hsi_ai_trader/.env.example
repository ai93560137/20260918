# 複製做 .env 再填

# --- Futu OpenD ---
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
TRD_ENV=SIMULATE            # 試完冇問題先改 REAL
FUTU_ACC_ID=0               # 0 = 自動揀第一個期貨戶口
FUTU_TRADE_PASSWORD=        # 留空 = 已喺 OpenD 介面解鎖交易

# --- Claude ---
ANTHROPIC_API_KEY=            # 只填喺部機 .env，唔好 commit
CLAUDE_MODEL=claude-sonnet-5-5
DECISION_INTERVAL_MIN=5

# --- 硬性風控（AI 無權超越）---
MAX_QTY=1
DAILY_LOSS_LIMIT=10000
# 使用者 2026-10-16 取消下面三條限制（0／false = 唔限）
MAX_STOP_POINTS=0           # 每張單止蝕上限點數
MIN_STOP_POINTS=0
MAX_TRADES_PER_DAY=0
EMERGENCY_STOP_POINTS=150   # 接手未知倉位時嘅緊急止蝕
NO_ENTRY_BEFORE_CLOSE_MIN=10
FLATTEN_BEFORE_NIGHT_CLOSE=false
FLATTEN_BEFORE_NIGHT_CLOSE_MIN=10
SLIPPAGE_POINTS=3
